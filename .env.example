# Replace the placeholders with two valid provider keys for live inference.
# Use LLM_MODE=mock for an offline local demo that needs no provider account.
LLM_MODE=litellm
LLM_API_KEYS=replace-with-key-1,replace-with-key-2
LLM_MODEL=gemini/gemini-2.0-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT="You are a helpful assistant. Keep replies clear and concise."
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=256
LOG_LEVEL=INFO
VITE_API_BASE_URL=http://localhost:8000
